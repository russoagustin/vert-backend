	"item": [
		{
			"name": "Autenticación",
			"item": [
				{
					"name": "Iniciar Sesión (Login)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Si la cookie access_token está presente, extrae el token y lo guarda en la variable de colección 'token'",
									"var cookieHeader = pm.response.headers.get(\"Set-Cookie\");",
									"if (cookieHeader) {",
									"    var match = cookieHeader.match(/access_token=([^;]+)/);",
									"    if (match) {",
									"        pm.collectionVariables.set(\"token\", match[1]);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"admin\",\n    \"password\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Autentica al usuario mediante username y password. Si las credenciales son válidas, retorna 200 OK y establece una cookie HttpOnly 'access_token' con el JWT."
					},
					"response": []
				}
			]
		},
